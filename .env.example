# Leave DATABASE_URL unset to run on SQLite (zero config).
# Supabase: use the SESSION pooler URI (port 5432), not the transaction pooler.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# App's own Postgres schema on the shared Supabase project. Unset -> public.
DB_SCHEMA=mental_health
SQLITE_PATH=mental_health.db
# Tether chat tab. Required for /api/tether/chat; the tab shows a notice without it.
ANTHROPIC_API_KEY=sk-ant-...
# TETHER_MODEL=claude-opus-5-5
# TETHER_EFFORT=medium
# TETHER_PROMPT_FILE=/path/to/metaprompt.md   # unset -> app/tether/prompts/clinician.md
# TETHER_PATIENT_ID=pt_7f3a9c21              # unset -> first patient on file
